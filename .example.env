# Paystack (test/live)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Plan codes — create one Paystack plan per interval/tier on the dashboard
PAYSTACK_PLAN_PRO_MONTHLY=PLN_xxx
PAYSTACK_PLAN_PRO_ANNUAL=PLN_xxx
PAYSTACK_PLAN_PROPLUS_MONTHLY=PLN_xxx
PAYSTACK_PLAN_PROPLUS_ANNUAL=PLN_xxx

# App URL (no trailing slash)
APP_URL=http://localhost:3000

# Transactional email (Resend, verified domain agenticapp.cv)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=AgenticApp.cv <notifications@agenticapp.cv>
EMAIL_HIRING_FROM=AgenticApp.cv Hiring <hiring@agenticapp.cv>
EMAIL_REPLY_TO=
CRON_SECRET=
EMAIL_DAILY_LIMIT=90
EMAIL_MONTHLY_LIMIT=2700
EMAIL_ENABLED=true
EMAIL_DRY_RUN=false
EMAIL_DEV_ALLOWLIST=
EMAIL_FLAG_APPLICATION_REMINDER=false
EMAIL_FLAG_APPLICATION_SUBMITTED=true
EMAIL_FLAG_JOB_ALERTS=false
# Real inbox for the live send test (npm run test:email-live). .env.local only.
EMAIL_TEST_RECIPIENT=
