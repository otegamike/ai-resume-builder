{
  "name": "resumy-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:email-live": "vitest run --config vitest.live.config.ts",
    "check:pdf": "node scripts/check-legacy-pdf.mjs",
    "check:browser-support": "node scripts/check-browser-support.mjs",
    "postinstall": "node -e \"require('fs').cpSync('node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs', 'public/pdf.worker.min.mjs')\""
  },
  "browserslist": [
    "Chrome >= 120",
    "Edge >= 120",
    "Firefox >= 120",
    "Safari >= 16.4",
    "iOS >= 16.4",
    "Samsung >= 23",
    "not dead"
  ],
  "dependencies": {
    "@google/genai": "^1.51.0",
    "@napi-rs/canvas": "^1.0.0",
    "@react-email/components": "^1.0.12",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^11.9.0",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "cloudinary": "^2.10.0",
    "googleapis": "^173.0.0",
    "groq-sdk": "^1.1.2",
    "html2pdf.js": "^0.14.0",
    "jose": "4.15.9",
    "lucide-react": "^1.8.0",
    "mongoose": "^9.4.1",
    "motion": "^12.40.0",
    "next": "16.2.3",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.11.1",
    "recharts": "^3.8.1",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "eslint-plugin-es-x": "^9.7.0",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
